{#
  Shared login/signup modal markup — Site Redesign Reset, Phase 1.
  Byte-identical across dashboard_template.html and sentiment_template.html
  before this extraction (verified, not assumed); stock_template.html had
  none at all. One source now, included wherever templates/partials/
  auth_base.js.j2 is also included (the JS wires up every id referenced
  here).
#}
<div class="auth-modal-backdrop" id="auth-modal">
  <div class="auth-modal-card">
    <button class="auth-modal-close" id="auth-modal-close" aria-label="Close">&times;</button>
    <div class="auth-modal-title" id="auth-modal-title">Welcome back</div>
    <p class="auth-modal-sub">Log in to save a personal watchlist across sessions.</p>

    <div class="auth-tabs">
      <button class="auth-tab-btn active" id="auth-tab-login" type="button">Log in</button>
      <button class="auth-tab-btn" id="auth-tab-signup" type="button">Sign up</button>
    </div>

    <button class="google-oauth-btn" id="auth-google-btn" type="button">
      <svg width="17" height="17" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59A14.5 14.5 0 019.5 24c0-1.59.27-3.13.76-4.59l-7.98-6.19A23.94 23.94 0 000 24c0 3.87.92 7.53 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.9l-7.97 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
      Continue with Google
    </button>
    <div class="auth-divider"><span>or</span></div>

    <form class="auth-form active" id="auth-form-login">
      <div class="auth-field"><label for="auth-login-email">Email</label><input type="email" id="auth-login-email" required autocomplete="email"></div>
      <div class="auth-field"><label for="auth-login-password">Password</label><input type="password" id="auth-login-password" required autocomplete="current-password"></div>
      <button class="auth-submit-btn" type="submit">Log in</button>
    </form>

    <form class="auth-form" id="auth-form-signup">
      <div class="auth-field"><label for="auth-signup-email">Email</label><input type="email" id="auth-signup-email" required autocomplete="email"></div>
      <div class="auth-field"><label for="auth-signup-password">Password</label><input type="password" id="auth-signup-password" required autocomplete="new-password" minlength="6"></div>
      <button class="auth-submit-btn" type="submit">Create account</button>
    </form>

    <div class="auth-message" id="auth-message"></div>
  </div>
</div>
